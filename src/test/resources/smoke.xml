<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="PhoneBook smoke suite" verbose="1">
    <test name="Login and registration smoke tests">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="ui_tests.LoginTests"/>
            <class name="ui_tests.RegistrationTests"/>
        </classes>
    </test>
</suite>
